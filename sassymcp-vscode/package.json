{
  "name": "sassymcp",
  "displayName": "SassyMCP",
  "description": "One MCP server replacing 75+. Auto-configures Claude Desktop, Cursor, Windsurf, Continue, Cline, Zed, Grok and the VS Code Copilot agent.",
  "version": "1.3.5",
  "publisher": "sassyconsultingllc",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["AI", "Other"],
  "keywords": ["mcp", "ai", "claude", "copilot", "agent"],
  "icon": "resources/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.sassymcp/persona.md"
  ],
  "contributes": {
    "commands": [
      { "command": "sassymcp.runSetupWizard", "title": "SassyMCP: Run Setup Wizard" },
      { "command": "sassymcp.reinstallConfigs", "title": "SassyMCP: Reinstall Client Configs" },
      { "command": "sassymcp.openAuditLog", "title": "SassyMCP: Open Audit Log" },
      { "command": "sassymcp.openDeleteFolder", "title": "SassyMCP: Open _DELETE_ Folder" },
      { "command": "sassymcp.showBrainStatus", "title": "SassyMCP: Show Brain Status" }
    ],
    "configuration": {
      "title": "SassyMCP",
      "properties": {
        "sassymcp.exePath": {
          "type": "string",
          "default": "",
          "description": "Override path to sassymcp.exe (default: auto-detect from PATH)."
        },
        "sassymcp.runInstallOnActivation": {
          "type": "boolean",
          "default": true,
          "description": "Run `sassymcp install` to patch every detected MCP client config when the extension activates. Set to false if you've already patched them or want to do it manually."
        },
        "sassymcp.installRunOnce": {
          "type": "boolean",
          "default": true,
          "description": "If true, only run `sassymcp install` on the first activation per workspace. If false, run on every activation (idempotent)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.27.0"
  },
  "repository": { "type": "git", "url": "https://github.com/sassyconsultingllc/SassyMCP" },
  "license": "MIT"
}
